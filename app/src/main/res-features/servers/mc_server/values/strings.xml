    <string name="f_Mc_tunnel_guide">How to set it up</string>
    <string name="f_Mc_guide_1">Add your domain to Cloudflare (free plan).</string>
    <string name="f_Mc_guide_2" tools:ignore="TypographyDashes">Zero Trust, Networks, Tunnels: create a tunnel. Paste its token (after --token) above.</string>
    <string name="f_Mc_guide_3">Add a public hostname, e.g. tunnel.example.com: TCP, localhost:25565.</string>
    <string name="f_Mc_guide_4">On the players\' address, e.g. mc.example.com, add a TXT record: cloudflared-route=tunnel.example.com.</string>
    <string name="f_Mc_guide_5">Type mc.example.com above and check it.</string>
    <string name="f_Mc_guide_6">Players install Modflared and join mc.example.com.</string>
    <string name="f_Mc_guide_note">Two addresses: the tunnel\'s (a CNAME) can\'t have a TXT record too.</string>
