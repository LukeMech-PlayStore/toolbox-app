<?xml version="1.0" encoding="utf-8"?>
<!-- Spirit level widget: transparent, the layers (tinted by the launcher, the bubble moved by its
     margins) and the tilt. Padding and text size are mirrored in SpiritLevelWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:clipToOutline="true"
    tools:targetApi="s"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/w_level_dial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/fp_spirit_level">

        <ImageView
            android:id="@+id/w_level_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/level_ring" />

        <ImageView
            android:id="@+id/w_level_cross"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/level_cross" />

        <ImageView
            android:id="@+id/w_level_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/level_bubble" />
    </FrameLayout>

    <!-- Fixed size, so a new text doesn't lay the dial out again. The text sits ~2dp inside its
         20dp line, so 8dp above it and below the widget's padding give equal 10dp gaps:
         edge-dial, dial-text and text-edge -->
    <TextView
        android:id="@+id/w_level_status"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
